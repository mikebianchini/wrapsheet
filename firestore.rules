rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person's own "My Lists" index — private to them.
    match /users/{uid} {
      match /boards/{boardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // A list itself: anyone signed in (Google, or the Shortcut's dedicated
    // account) who has the link can read and write it and its people/gifts —
    // the same "anyone with the link" model as a shared Google Doc. Sharing
    // a list = sending its link; there's no separate invite queue to manage.
    match /boards/{boardId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
